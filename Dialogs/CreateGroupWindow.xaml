<Window x:Class="AdManager.Dialogs.CreateGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая группа" Width="620" SizeToContent="Height"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock Text="НОВАЯ ГРУППА" Style="{StaticResource H2}"/>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Подразделение" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="OuCombo" DisplayMemberPath="Display" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="1" Text="Область действия" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ScopeCombo" Margin="0,0,0,6">
                <ComboBoxItem Content="Глобальная" Tag="Global" IsSelected="True"/>
                <ComboBoxItem Content="Локальная домена" Tag="DomainLocal"/>
                <ComboBoxItem Content="Универсальная" Tag="Universal"/>
            </ComboBox>
        </Grid>

        <Grid x:Name="FieldsHost" Margin="0,2,0,0"/>

        <TextBlock Text="Описание" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,4"/>
        <TextBox x:Name="DescriptionBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalContentAlignment="Top"/>

        <CheckBox x:Name="SecurityCheck" Content="Группа безопасности" IsChecked="True" Margin="0,12,0,0"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrBrush}" FontSize="11"
                   Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" MinWidth="90" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Создать" MinWidth="120" Style="{StaticResource AccentButton}"
                    IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
