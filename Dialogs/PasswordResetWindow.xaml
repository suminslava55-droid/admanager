<Window x:Class="AdManager.Dialogs.PasswordResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сброс пароля" Width="500" SizeToContent="Height"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="СБРОС ПАРОЛЯ" Style="{StaticResource H2}"/>
        <TextBlock x:Name="TargetText" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>

        <TextBlock Text="Новый пароль" Style="{StaticResource SectionHeader}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PasswordBox" FontFamily="{StaticResource MonoFont}" FontSize="14"
                     VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="Сгенерировать" Margin="8,0,0,0" Click="Generate_Click"/>
        </Grid>

        <TextBlock Text="Пароль виден оператору — передайте его пользователю по защищённому каналу."
                   Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap"/>

        <CheckBox x:Name="MustChangeCheck" Content="Потребовать смену пароля при следующем входе"
                  IsChecked="True" Margin="0,14,0,0"/>
        <CheckBox x:Name="UnlockCheck" Content="Разблокировать учётную запись, если она заблокирована"
                  Margin="0,8,0,0"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrBrush}" FontSize="11"
                   Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Отмена" MinWidth="90" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Сбросить пароль" MinWidth="150" Style="{StaticResource AccentButton}"
                    IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
