<Window x:Class="AdManager.Dialogs.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AdManager" Width="480" SizeToContent="Height"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <Border x:Name="IconBorder" Width="34" Height="34" CornerRadius="17" DockPanel.Dock="Left"
                    Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                <TextBlock x:Name="IconText" Text="i" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource InfoBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="HeaderText" Text="Заголовок" Style="{StaticResource H2}"
                       Margin="12,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>

        <TextBlock x:Name="MessageText" Grid.Row="1" Text="Сообщение" Margin="0,14,0,0"
                   TextWrapping="Wrap" FontSize="12" LineHeight="18"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="Отмена" MinWidth="90" Margin="0,0,8,0"
                    Visibility="Collapsed" Click="Cancel_Click" IsCancel="True"/>
            <Button x:Name="OkButton" Content="ОК" MinWidth="90" Style="{StaticResource AccentButton}"
                    IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
