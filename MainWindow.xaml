<Window x:Class="AdManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:AdManager.Models"
        xmlns:conv="clr-namespace:AdManager.Converters"
        mc:Ignorable="d"
        Title="AdManager"
        Width="1600" Height="920" MinWidth="1100" MinHeight="680"
        Background="{StaticResource BgBrush}"
        Icon="pack://application:,,,/Assets/AdManager.ico"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:HexBrushConverter x:Key="HexBrush"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolVis"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolVisInvert" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullVis" Invert="True"/>
        <conv:CountToVisibilityConverter x:Key="EmptyCountVis"/>
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringVis"/>

        <Style x:Key="KpiButton" TargetType="Button">
            <Setter Property="Width" Value="132"/>
            <Setter Property="Height" Value="66"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type models:AdOu}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DistinguishedName}" Margin="0,1"
                       TextTrimming="CharacterEllipsis"/>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ===================== Шапка ===================== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/AdManager-256.png" Width="34" Height="34"
                           VerticalAlignment="Center"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AdManager" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource OkBrush}" Margin="0,0,6,0"
                             Visibility="{Binding IsConnected, Converter={StaticResource BoolVis}}"/>
                    <Ellipse Width="8" Height="8" Fill="{StaticResource ErrBrush}" Margin="0,0,6,0"
                             Visibility="{Binding IsConnected, Converter={StaticResource BoolVisInvert}}"/>
                    <TextBlock Text="{Binding ConnectionStatus}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ConnectionDetails}" Style="{StaticResource MutedText}" Margin="10,0,0,0"/>
                    <Border Style="{StaticResource Badge}" Background="#3A2E18" Margin="10,0,0,0"
                            Visibility="{Binding IsDemo, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="ДЕМО" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"/>
                    </Border>
                    <Border Style="{StaticResource Badge}" Background="#33211F" Margin="8,0,0,0"
                            Visibility="{Binding ShowElevationWarning, Converter={StaticResource BoolVis}}"
                            ToolTip="Не все атрибуты Active Directory доступны без прав администратора. Запустите AdManager от имени администратора.">
                        <TextBlock Text="БЕЗ ПРАВ АДМИНА" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource ErrBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Обновить (F5)" Margin="0,0,6,0" Command="{Binding RefreshCommand}"/>
                    <Button Content="Создать УЗ" Margin="0,0,6,0" Command="{Binding CreateUserCommand}"/>
                    <Button Content="Создать группу" Margin="0,0,6,0" Command="{Binding CreateGroupCommand}"/>
                    <Button Content="Настройки" Margin="0,0,6,0" Command="{Binding OpenSettingsCommand}"/>
                    <Button Content="Диагностика" Margin="0,0,6,0" Command="{Binding DiagnosticsCommand}"
                            ToolTip="Сохранить отчёт о подключении, группах и выбранной УЗ"/>
                    <Button Content="Журнал" Command="{Binding OpenAuditFolderCommand}" ToolTip="Открыть папку журнала операций"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Панель фильтров ===================== -->
        <Border Grid.Row="1" Background="#202025" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Поиск" Style="{StaticResource MutedText}" Margin="0,0,8,0"/>
                    <Grid Width="320">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Имя, логин, почта, отдел, должность. Enter — перезагрузить с сервера."/>
                        <TextBlock Text="начните вводить…" Foreground="#5A5A64" IsHitTestVisible="False"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyStringVis}}"/>
                    </Grid>
                    <Button Content="Очистить" Margin="6,0,0,0" Command="{Binding ClearSearchCommand}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <CheckBox Content="Только проблемы" IsChecked="{Binding OnlyProblems}" Margin="0,0,14,0"/>
                    <CheckBox Content="С отключёнными" IsChecked="{Binding IncludeDisabled}" Margin="0,0,14,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Неактивен более" Style="{StaticResource MutedText}" Margin="0,0,6,0"/>
                    <TextBox Width="52" Text="{Binding StaleDays, UpdateSourceTrigger=LostFocus}"
                             ToolTip="Порог неактивности в днях для access review"/>
                    <TextBlock Text="дн." Style="{StaticResource MutedText}" Margin="6,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{Binding SelectionText}" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- ===================== Контент ===================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="470" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Дерево OU -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="ПОДРАЗДЕЛЕНИЯ" Style="{StaticResource SectionHeader}" Margin="0,0,0,2"/>
                    <TextBlock Grid.Row="1" Text="{Binding SelectedOuPath}" Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                    <TreeView Grid.Row="2" ItemsSource="{Binding OuRoots}" x:Name="OuTree"
                              SelectedItemChanged="OuTree_SelectedItemChanged"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock Text="ЭКСПОРТ" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                        <Button Content="Пользователи → CSV" Margin="0,0,0,4" Command="{Binding ExportUsersCsvCommand}"/>
                        <Button Content="Группы → CSV" Margin="0,0,0,4" Command="{Binding ExportGroupsCsvCommand}"/>
                        <Button Content="Проблемы → CSV" Margin="0,0,0,4" Command="{Binding ExportIssuesCsvCommand}"/>
                        <Button Content="HTML-отчёт для ИБ" Style="{StaticResource AccentButton}"
                                Command="{Binding ExportHtmlCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <!-- Центр -->
            <Grid Grid.Column="2" Margin="12,10,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="84"
                              Background="{StaticResource BgBrush}"
                              x:Name="KpiScroll" PreviewMouseWheel="KpiScroll_PreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding KpiItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource KpiButton}"
                                        Command="{Binding DataContext.KpiFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Filter}"
                                        ToolTip="Показать объекты с этим признаком">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding Accent, Converter={StaticResource HexBrush}}"
                                                CornerRadius="2" Margin="6,8,0,8"/>
                                        <StackPanel Grid.Column="1" Margin="10,7,8,7" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Value}" FontSize="19" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap" MaxHeight="24"/>
                                        </StackPanel>
                                        <Border Grid.ColumnSpan="2" BorderBrush="{StaticResource AccentHotBrush}"
                                                BorderThickness="0,0,0,2" CornerRadius="0,0,6,6" Margin="1,0,1,0"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TabControl Grid.Row="1" Margin="0,10,0,0" SelectedIndex="{Binding TabIndex, Mode=TwoWay}">
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Пользователи"/>
                                <Border Style="{StaticResource Badge}" Background="{StaticResource Surface3Brush}" Margin="7,0,0,0">
                                    <TextBlock Text="{Binding Users.Count}" FontSize="10"/>
                                </Border>
                            </StackPanel>
                        </TabItem.Header>
                        <DataGrid x:Name="UsersGrid" ItemsSource="{Binding UsersView}"
                                  SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                  SelectionChanged="UsersGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Имя" Binding="{Binding DisplayLabel}" Width="170"/>
                                <DataGridTextColumn Header="Логин" Binding="{Binding SamAccountName}" Width="100"/>
                                <DataGridTemplateColumn Header="Статус" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}"
                                                       Foreground="{Binding StatusColor, Converter={StaticResource HexBrush}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Привил." Width="55">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#3A2E18" CornerRadius="3" Padding="5,1"
                                                    HorizontalAlignment="Left"
                                                    ToolTip="{Binding PrivilegedGroupsText}"
                                                    Visibility="{Binding IsPrivileged, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="ADMIN" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{StaticResource WarnBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Отдел" Binding="{Binding DepartmentDisplay}" Width="95"/>
                                <DataGridTextColumn Header="Последний вход" Binding="{Binding LastLogonText}" Width="120"/>
                                <DataGridTemplateColumn Header="Риски" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RiskShort}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding RiskShort}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasRiskFlags}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Группы"/>
                                <Border Style="{StaticResource Badge}" Background="{StaticResource Surface3Brush}" Margin="7,0,0,0">
                                    <TextBlock Text="{Binding Groups.Count}" FontSize="10"/>
                                </Border>
                            </StackPanel>
                        </TabItem.Header>
                        <DataGrid x:Name="GroupsGrid" ItemsSource="{Binding GroupsView}"
                                  SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                  SelectionChanged="GroupsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Группа" Binding="{Binding Name}" Width="155"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Логин" Binding="{Binding SamAccountName}" Width="95"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding GroupTypeText}" Width="185"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Участников" Binding="{Binding MemberCountText}" Width="72"/>
                                <DataGridTemplateColumn Header="Привил." Width="55">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#3A2E18" CornerRadius="3" Padding="5,1"
                                                    HorizontalAlignment="Left"
                                                    ToolTip="Группа даёт привилегии в домене"
                                                    Visibility="{Binding IsPrivileged, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="ADMIN" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{StaticResource WarnBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Владелец" Binding="{Binding ManagedByDisplay}" Width="75"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Риски" Binding="{Binding RiskShort}" Width="*"
                                                    ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Проблемы"/>
                                <Border Style="{StaticResource Badge}" Background="#33211F" Margin="7,0,0,0">
                                    <TextBlock Text="{Binding Issues.Count}" FontSize="10" Foreground="{StaticResource ErrBrush}"/>
                                </Border>
                            </StackPanel>
                        </TabItem.Header>
                        <DataGrid ItemsSource="{Binding IssuesView}"
                                  SelectedItem="{Binding SelectedIssue, Mode=TwoWay}" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Важность" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SeverityText}" FontWeight="SemiBold"
                                                       Foreground="{Binding SeverityColor, Converter={StaticResource HexBrush}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="200"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding ObjectType}" Width="95"/>
                                <DataGridTextColumn Header="Объект" Binding="{Binding ObjectName}" Width="170"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Логин" Binding="{Binding SamAccountName}" Width="110"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Детали" Binding="{Binding Details}" Width="*"
                                                    ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <!-- Карточка -->
            <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="12,10,12,10">
                    <ContentControl Content="{Binding SelectedObject}"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding SelectedObject, Converter={StaticResource NullVis}}">
                        <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource Surface2Brush}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="?" FontSize="24" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Выберите пользователя или группу" Style="{StaticResource MutedText}"
                                   Margin="0,12,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="Карточка покажет доступы, риски и действия"
                                   Style="{StaticResource CaptionText}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Индикатор загрузки -->
            <Border Grid.ColumnSpan="5" Background="#CC141417" Panel.ZIndex="10"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="240"/>
                    <TextBlock Text="{Binding BusyText}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== Статус ===================== -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Обновлено: " Style="{StaticResource CaptionText}"/>
                    <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource CaptionText}"/>
                    <TextBlock Text="  ·  " Style="{StaticResource CaptionText}"/>
                    <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource CaptionText}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
