<UserControl x:Class="AdManager.Views.UserDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AdManager.Converters"
             xmlns:models="clr-namespace:AdManager.Models">
    <UserControl.Resources>
        <conv:HexBrushConverter x:Key="HexBrush"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolVis"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolVisInvert" Invert="True"/>
        <conv:BoolToRussianConverter x:Key="BoolRu"/>

        <DataTemplate x:Key="RiskTemplate" DataType="{x:Type models:RiskFlag}">
            <Border Background="{StaticResource Surface2Brush}" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding SeverityColor, Converter={StaticResource HexBrush}}" CornerRadius="2" Margin="0,1,0,1"/>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0">
                        <DockPanel>
                            <TextBlock Text="{Binding SeverityText}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{Binding SeverityColor, Converter={StaticResource HexBrush}}"
                                       DockPanel.Dock="Right" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
        <StackPanel>
            <!-- Шапка -->
            <Border Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <DockPanel>
                        <Border Width="50" Height="50" CornerRadius="25" Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" DockPanel.Dock="Left"
                                VerticalAlignment="Top">
                            <TextBlock Text="{Binding Initials}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentHotBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayLabel}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SamDisplay}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="{Binding StatusColor, Converter={StaticResource HexBrush}}"
                                        CornerRadius="3" Padding="7,2" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold" Foreground="#121215"/>
                                </Border>
                                <Border Style="{StaticResource Badge}" Background="#3A2E18"
                                        Visibility="{Binding IsPrivileged, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="ПРИВИЛЕГИРОВАННАЯ" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{StaticResource WarnBrush}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Сброс пароля" Margin="0,0,6,6"
                                Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Content="Группы" Margin="0,0,6,6"
                                Command="{Binding DataContext.AddToGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Content="Копировать" Margin="0,0,6,6"
                                Command="{Binding DataContext.CopyUserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="Создать новую УЗ с теми же группами и правами"/>
                        <Button Content="Редактировать" Margin="0,0,6,6"
                                Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Content="Вкл/выкл" Margin="0,0,6,6"
                                Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Content="Разблокировать" Margin="0,0,6,6"
                                Command="{Binding DataContext.UnlockCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Content="Срок УЗ" Margin="0,0,6,6"
                                Command="{Binding DataContext.SetExpirationCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Content="Переместить" Margin="0,0,6,6"
                                Command="{Binding DataContext.MoveOuCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Content="Удалить" Style="{StaticResource DangerButton}" Margin="0,0,6,6"
                                Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TabControl Margin="0,8,0,0" FontSize="12">
                <TabItem Header="Обзор">
                    <StackPanel Margin="2,8,2,0">
                        <TextBlock Text="ПРОБЛЕМЫ ДОСТУПА" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding RiskFlags}" ItemTemplate="{StaticResource RiskTemplate}"/>
                        <TextBlock Text="Проблем не найдено" Style="{StaticResource MutedText}" FontSize="12"
                                   Visibility="{Binding HasRiskFlags, Converter={StaticResource BoolVisInvert}}"/>

                        <TextBlock Text="КОНТАКТЫ" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Почта" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MailDisplay}" Margin="0,2" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="1" Text="Телефон" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PhoneDisplay}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Text="Мобильный" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MobileDisplay}" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Text="Кабинет" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OfficeDisplay}" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Text="Отдел" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DepartmentDisplay}" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Text="Должность" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TitleDisplay}" Margin="0,2" TextWrapping="Wrap"/>
                        </Grid>

                        <TextBlock Text="ОРГАНИЗАЦИЯ" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Руководитель" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ManagerDisplay}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Text="Подразделение" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OuDisplay}" Margin="0,2" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Text="Описание" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DescriptionDisplay}" Margin="0,2" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Доступ">
                    <StackPanel Margin="2,8,2,0">
                        <TextBlock Text="ПРИВИЛЕГИРОВАННЫЕ ГРУППЫ" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                        <Border Style="{StaticResource Card}" Padding="10" Background="{StaticResource ConsoleBgBrush}">
                            <TextBlock Text="{Binding PrivilegedGroupsText}" TextWrapping="Wrap" FontSize="12"/>
                        </Border>

                        <TextBlock Text="СОСТОИТ В ГРУППАХ" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource Card}" Padding="10" Background="{StaticResource ConsoleBgBrush}">
                            <TextBlock Text="{Binding MemberOfNames}" TextWrapping="Wrap" FontSize="12"/>
                        </Border>

                        <TextBlock Text="ЭФФЕКТИВНЫЕ ГРУППЫ (С УЧЁТОМ ВЛОЖЕННОСТИ)" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource Card}" Padding="10" Background="{StaticResource ConsoleBgBrush}">
                            <TextBlock Text="{Binding EffectiveGroupsText}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource InfoBrush}"/>
                        </Border>

                        <TextBlock Text="БЫСТРЫЕ ДЕЙСТВИЯ" Style="{StaticResource SectionHeader}"/>
                        <WrapPanel>
                            <Button Content="Добавить в группы" Margin="0,0,6,6" Style="{StaticResource AccentButton}"
                                    Command="{Binding DataContext.AddToGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Button Content="Убрать из групп" Margin="0,0,6,6"
                                    Command="{Binding DataContext.RemoveFromGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </WrapPanel>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Учётная">
                    <StackPanel Margin="2,8,2,0">
                        <TextBlock Text="УЧЁТНАЯ ЗАПИСЬ" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="UPN" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding UpnDisplay}" Margin="0,2" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="1" Text="Последний вход" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastLogonText}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Text="Неактивен" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DaysInactiveText}" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Text="Пароль установлен" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PasswordLastSetText}" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Text="Пароль истекает" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PasswordExpiresText}" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Text="Срок УЗ" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AccountExpiresText}" Margin="0,2"/>
                            <TextBlock Grid.Row="6" Text="Создана" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding WhenCreatedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="7" Text="Изменена" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding WhenChangedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="8" Text="SID" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding ObjectSid}" Margin="0,2" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="9" Text="DN" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding DistinguishedName}" Margin="0,2" TextWrapping="Wrap" FontSize="11"/>
                            <TextBlock Grid.Row="10" Text="ПК последнего входа" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding LastLogonWorkstationText}" Margin="0,2" TextWrapping="Wrap"
                                       ToolTip="Определяется по журналу Security на контроллере домена. Может отсутствовать без прав на журнал."/>
                        </Grid>

                        <TextBlock Text="ФЛАГИ БЕЗОПАСНОСТИ" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="185"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="adminCount" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AdminCount, Converter={StaticResource BoolRu}}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Text="SPN" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HasSpn, Converter={StaticResource BoolRu}}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Text="AS-REP (no preauth)" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DontRequirePreAuth, Converter={StaticResource BoolRu}}" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Text="Unconstrained delegation" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TrustedForDelegation, Converter={StaticResource BoolRu}}" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Text="Constrained delegation" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HasConstrainedDelegation, Converter={StaticResource BoolRu}}" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Text="SID History" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding HasSidHistory, Converter={StaticResource BoolRu}}" Margin="0,2"/>
                            <TextBlock Grid.Row="6" Text="Пароль не истекает" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding PasswordNeverExpires, Converter={StaticResource BoolRu}}" Margin="0,2"/>
                            <TextBlock Grid.Row="7" Text="Пароль не требуется" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding PasswordNotRequired, Converter={StaticResource BoolRu}}" Margin="0,2"/>
                            <TextBlock Grid.Row="8" Text="DES only" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding UseDesKeyOnly, Converter={StaticResource BoolRu}}" Margin="0,2"/>
                        </Grid>

                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Пароль не истекает" Margin="0,0,6,6"
                                    Command="{Binding DataContext.TogglePasswordNeverExpiresCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Button Content="Сбросить возраст пароля" Margin="0,0,6,6"
                                    Command="{Binding DataContext.ResetPasswordAgeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="pwdLastSet=-1: пароль считается изменённым сегодня, срок действия начинается заново. Сам пароль не меняется."/>
                            <Button Content="Требовать смену пароля" Margin="0,0,6,6"
                                    Command="{Binding DataContext.MustChangePasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="pwdLastSet=0: потребовать смену пароля при следующем входе."/>
                        </WrapPanel>
                        <TextBlock Text="«Сбросить возраст пароля» не меняет пароль, а только обнуляет счётчик его срока (pwdLastSet = -1)."
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Атрибуты">
                    <DataGrid ItemsSource="{Binding AllAttributeItems}" IsReadOnly="True" Margin="0,8,0,0"
                              HeadersVisibility="Column" SelectionMode="Single" FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Атрибут" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
