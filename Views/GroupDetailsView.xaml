<UserControl x:Class="AdManager.Views.GroupDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AdManager.Converters"
             xmlns:models="clr-namespace:AdManager.Models">
    <UserControl.Resources>
        <conv:HexBrushConverter x:Key="HexBrush"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolVis"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolVisInvert" Invert="True"/>
        <conv:CountToVisibilityConverter x:Key="EmptyCountVis"/>
        <conv:NullToVisibilityConverter x:Key="NotNullVis"/>

        <Style x:Key="MemberCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>

        <DataTemplate x:Key="RiskTemplate" DataType="{x:Type models:RiskFlag}">
            <Border Background="{StaticResource Surface2Brush}" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding SeverityColor, Converter={StaticResource HexBrush}}" CornerRadius="2" Margin="0,1,0,1"/>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0">
                        <DockPanel>
                            <TextBlock Text="{Binding SeverityText}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{Binding SeverityColor, Converter={StaticResource HexBrush}}"
                                       DockPanel.Dock="Right" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="14">
            <StackPanel>
                <DockPanel>
                    <Border Width="44" Height="44" CornerRadius="8" Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" DockPanel.Dock="Left"
                            VerticalAlignment="Top">
                        <Path Data="M 2 8 L 8 2 L 14 8 L 14 16 L 2 16 Z" Stroke="{StaticResource InfoBrush}"
                              StrokeThickness="1.4" Fill="Transparent" Stretch="Uniform" Margin="10"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SamAccountName}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border Style="{StaticResource Badge}" Background="{StaticResource Surface3Brush}">
                                <TextBlock Text="{Binding GroupTypeText}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="#3A2E18" Margin="6,0,0,0"
                                    Visibility="{Binding IsPrivileged, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="ПРИВИЛЕГИРОВАННАЯ" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource WarnBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <WrapPanel Margin="0,12,0,0">
                    <Button Content="Добавить участников" Style="{StaticResource AccentButton}" Margin="0,0,6,6"
                            Command="{Binding DataContext.AddGroupMemberCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Content="Удалить участника" Margin="0,0,6,6"
                            Command="{Binding DataContext.RemoveGroupMemberCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Content="Удалить группу" Style="{StaticResource DangerButton}" Margin="0,0,6,6"
                            Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="0,8,0,0" FontSize="12">
            <TabItem Header="Обзор">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="2,8,2,0">
                    <StackPanel>
                        <TextBlock Text="ПРОБЛЕМЫ" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding RiskFlags}" ItemTemplate="{StaticResource RiskTemplate}"/>
                        <TextBlock Text="Проблем не найдено" Style="{StaticResource MutedText}" FontSize="12"
                                   Visibility="{Binding RiskFlags.Count, Converter={StaticResource EmptyCountVis}}"/>

                        <TextBlock Text="СВЕДЕНИЯ" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Участников" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MemberCountText}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Text="Владелец" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ManagedByDisplay}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Text="Область" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GroupScopeText}" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Text="Создана" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WhenCreatedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Text="Изменена" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding WhenChangedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Text="Описание" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DescriptionDisplay}" Margin="0,2" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="6" Text="OU" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding OuDisplay}" Margin="0,2" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="7" Text="DN" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding DistinguishedName}" Margin="0,2"
                                       TextWrapping="Wrap" FontSize="11"/>
                        </Grid>

                        <TextBlock Text="ВХОДИТ В ГРУППЫ" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource Card}" Padding="10" Background="{StaticResource ConsoleBgBrush}">
                            <TextBlock Text="{Binding MemberOfNames}" TextWrapping="Wrap" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Участники">
                <DataGrid ItemsSource="{Binding Members}" Margin="0,8,0,0" IsReadOnly="True" FontSize="12"
                          SelectionMode="Single"
                          SelectedItem="{Binding DataContext.SelectedMember, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Тип" Binding="{Binding KindText}" Width="60"/>
                        <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*" MinWidth="150"
                                            ElementStyle="{StaticResource MemberCell}"/>
                        <DataGridTextColumn Header="Логин" Binding="{Binding SamDisplay}" Width="88"
                                            ElementStyle="{StaticResource MemberCell}"/>
                        <DataGridTextColumn Header="Отдел" Binding="{Binding DepartmentDisplay}" Width="70"
                                            ElementStyle="{StaticResource MemberCell}"/>
                        <DataGridTextColumn Header="Привил." Binding="{Binding PrivilegedText}" Width="44"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Атрибуты">
                <DataGrid ItemsSource="{Binding AllAttributeItems}" IsReadOnly="True" Margin="0,8,0,0"
                          HeadersVisibility="Column" SelectionMode="Single" FontSize="11">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Атрибут" Binding="{Binding Name}" Width="150"/>
                        <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
